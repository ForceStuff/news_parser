# All configuration belongs to news_parser. Never use tokens copied from another service.
DATABASE_URL=sqlite:///./news_parser.db
API_KEY=replace-with-a-long-random-key

FILE_SERVICE_URL=http://localhost:8001
FILE_PUBLIC_URL=http://localhost:8001
# Must be a credential explicitly granted for news_parser by the deployment owner.
FILE_SERVICE_TOKEN=

# PUBLIC_MVP disables writes in the existing news_service.
NEWS_EXPORT_ENABLED=false
NEWS_SERVICE_URL=http://localhost:8000
# Gateway deployments: set a valid admin bearer token.
NEWS_BEARER_TOKEN=
# Direct trusted internal network only: gateway-style identity headers.
NEWS_USER_ID=
NEWS_USER_ROLES=admin

REQUEST_TIMEOUT=20
DOWNLOAD_TIMEOUT=120
REQUEST_INTERVAL=1
WORKER_POLL_SECONDS=2
MAX_HTML_BYTES=4194304
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_DOWNLOAD_BYTES=20971520
MAX_IMAGES=20
USER_AGENT=NewsParser/1.0

# Docker Compose only:
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
